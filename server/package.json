{
  "name": "connectify-server",
  "version": "1.0.0",
  "private": true,
  "description": "Connectify API — Express + MongoDB + Socket.IO",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
