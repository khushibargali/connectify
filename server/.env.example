# Server
PORT=4000
NODE_ENV=development

# MongoDB — leave empty in development to use an in-memory MongoDB
MONGO_URI=mongodb://localhost:27017/connectify

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed origins; * wildcards allowed (e.g. https://*.vercel.app)
CLIENT_ORIGIN=http://localhost:5173

# Seed demo users (alice/bob/carol/dave, password "password123") on startup if the DB is empty
SEED_DEMO=false
